{
  "name": "supergannt",
  "private": true,
  "version": "1.0.2",
  "author": "SuperGantt",
  "description": "Modern MS Project / ProjectLibre alternative — open and save .mpp in the browser or desktop (Tauri / WebView2)",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "oxlint",
    "preview": "concurrently --kill-others-on-fail \"cross-env NODE_ENV=production PORT=4173 tsx server/index.ts\" \"vite preview --host --port 4174\"",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mpp:setup": "node scripts/setup-mpp.mjs",
    "mpp:fixtures": "node scripts/fetch-mpp-fixtures.mjs",
    "tauri:stage": "node scripts/pack-tauri.mjs --stage",
    "tauri:pack": "node scripts/pack-tauri.mjs",
    "desktop:pack": "node scripts/pack-tauri.mjs",
    "tauri": "tauri",
    "android:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-android.ps1",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "server:bundle": "node scripts/bundle-server.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@byteink/mppjs": "^0.1.5",
    "@hono/node-server": "^2.0.12",
    "@tauri-apps/api": "^2.11.1",
    "dhtmlx-gantt": "^9.0.14",
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.12.32",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@byteink/mppjs-darwin-arm64": "^0.1.5",
    "@byteink/mppjs-linux-arm64": "^0.1.5",
    "@byteink/mppjs-linux-x64": "^0.1.5",
    "@byteink/mppjs-win32-x64": "^0.1.5"
  }
}
