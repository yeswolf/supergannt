{
  "name": "supergannt",
  "private": true,
  "version": "1.0.0",
  "description": "Modern MS Project / ProjectLibre alternative — open .mpp via MPXJ, edit plans in browser or desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "oxlint",
    "preview": "concurrently --kill-others-on-fail \"cross-env NODE_ENV=production PORT=4173 tsx server/index.ts\" \"vite preview --host --port 4174\"",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mpp:setup": "node scripts/setup-mpp.mjs",
    "mpp:fixtures": "node scripts/fetch-mpp-fixtures.mjs",
    "desktop": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.mjs",
    "desktop:dev": "concurrently --kill-others-on-fail \"npm:dev\" \"wait-on http://localhost:5173 && npm run desktop\"",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:pack": "npm run build && electron-builder",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@byteink/mppjs": "^0.1.5",
    "@hono/node-server": "^2.0.12",
    "dhtmlx-gantt": "^9.0.14",
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.12.32",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.supergannt.app",
    "productName": "SuperGantt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "optionalDependencies": {
    "@byteink/mppjs-darwin-arm64": "^0.1.5",
    "@byteink/mppjs-linux-arm64": "^0.1.5",
    "@byteink/mppjs-linux-x64": "^0.1.5",
    "@byteink/mppjs-win32-x64": "^0.1.5"
  }
}
