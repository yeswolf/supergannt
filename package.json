{
  "name": "supergannt",
  "private": true,
  "version": "1.0.0",
  "author": "SuperGantt",
  "description": "Modern MS Project / ProjectLibre alternative — open and save .mpp in the browser or desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "oxlint",
    "preview": "concurrently --kill-others-on-fail \"cross-env NODE_ENV=production PORT=4173 tsx server/index.ts\" \"vite preview --host --port 4174\"",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mpp:setup": "node scripts/setup-mpp.mjs",
    "mpp:fixtures": "node scripts/fetch-mpp-fixtures.mjs",
    "desktop": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.mjs",
    "desktop:dev": "concurrently --kill-others-on-fail \"npm:dev\" \"wait-on http://localhost:5173 && npm run desktop\"",
    "desktop:build": "node scripts/pack-desktop.mjs --dir",
    "desktop:pack": "node scripts/pack-desktop.mjs",
    "desktop:pack:dir": "node scripts/pack-desktop.mjs --dir",
    "tauri:stage": "node scripts/pack-tauri.mjs --stage",
    "tauri:pack": "node scripts/pack-tauri.mjs",
    "server:bundle": "node scripts/bundle-server.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@byteink/mppjs": "^0.1.5",
    "@hono/node-server": "^2.0.12",
    "@tauri-apps/api": "^2.11.1",
    "dhtmlx-gantt": "^9.0.14",
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.12.32",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.supergannt.app",
    "productName": "SuperGantt",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build-desktop/server",
        "to": "server"
      },
      {
        "from": "build-desktop/mpp",
        "to": "mpp"
      },
      {
        "from": "build-desktop/ui",
        "to": "ui"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "SuperGantt-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SuperGantt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "differentialPackage": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  },
  "optionalDependencies": {
    "@byteink/mppjs-darwin-arm64": "^0.1.5",
    "@byteink/mppjs-linux-arm64": "^0.1.5",
    "@byteink/mppjs-linux-x64": "^0.1.5",
    "@byteink/mppjs-win32-x64": "^0.1.5"
  }
}
