{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default SuperGantt capabilities (desktop sidecar + offline converters)",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-set-webview-focus",
    "allow-save-file",
    "allow-mpp-to-xml",
    "allow-xml-to-mpp"
  ]
}
